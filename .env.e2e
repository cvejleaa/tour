# Vite-mode "e2e": bruges af Playwrights platform-build (playwright.config.js).
# Dummy-nøgler — appen taler kun med emulatorerne (VITE_USE_EMULATORS=true),
# så intet her er hemmeligt. Overstyrer .env for de nøgler, der står her.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-vm2026
VITE_FIREBASE_STORAGE_BUCKET=demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
VITE_PLATFORM_MODE=true
VITE_OWNER_EMAIL=ejer@e2e.test
